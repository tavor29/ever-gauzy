# Gauzy's PostgreSQL. The relay reads/marks board_outbox; automations reads users and project
# managers and keeps its own automation_runs table. Use a dedicated role in production.
DATABASE_URL=postgres://gauzy:change-me@db:5432/gauzy

KAFKA_BROKERS=kafka:9092
BOARD_EVENTS_TOPIC=board.task-events

# Shared with the Gauzy API (same variable name there). Generate with: openssl rand -hex 32
LIVE_BOARD_SECRET=

SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Task Board <board@localhost>

# Optional knobs
# RELAY_BATCH=100
# RELAY_IDLE_MS=500
# LIVE_MAX_CONNECTION_MS=900000
