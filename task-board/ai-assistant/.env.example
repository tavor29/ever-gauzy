# Copy to .env and fill in. Never commit .env.

# Shared secret between the app backend and the RAG service.
RAG_SERVICE_TOKEN=change-me-long-random-string

QDRANT_API_KEY=change-me-long-random-string
QDRANT_COLLECTION=pm_items

# Model served by Ollama (name given in `ollama create`).
LLM_MODEL=pm-mistral
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=768

# Local embedding model. Use intfloat/multilingual-e5-small if boards contain Hebrew.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

RAG_TOP_K=8
RAG_MIN_SCORE=0.35
MAX_CONTEXT_CHARS=12000

# Kafka task events (from the event layer). Leave empty to use the HTTP /index webhook instead.
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=board.task-events
KAFKA_GROUP=rag-indexer
